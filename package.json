{
  "name": "ts-mailkit",
  "version": "2.1.0",
  "description": "Strictly typed, modular, and composable email composition and dispatch library for TypeScript and modern edge runtimes.",
  "keywords": [
    "dto",
    "edge",
    "email",
    "mailer",
    "transactional-email",
    "typescript",
    "workerd",
    "zeptomail",
    "zoho-mail"
  ],
  "homepage": "https://github.com/AD-RIAN-Studio/ts-mailkit#readme",
  "bugs": {
    "url": "https://github.com/AD-RIAN-Studio/ts-mailkit/issues"
  },
  "license": "MIT",
  "author": "AD-RIAN Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AD-RIAN-Studio/ts-mailkit.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tsc --emitDeclarationOnly",
    "dev": "vp pack --watch",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "tsc --noEmit",
    "test": "vp test run test/unit",
    "test:unit": "vp test run test/unit",
    "test:watch": "vp test test/unit",
    "prepublishOnly": "pnpm run check && pnpm run typecheck && pnpm run test:unit && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
